-- Read a creation timestamp, then report the host answer and output status.

mu FileCreatedState : Type 0 with
| requested : Words -> FileCreatedState
| reporting : Nat -> Bytes -> FileCreatedState
| finished : Nat -> FileCreatedState

def init (argv : Words) : FileCreatedState := requested argv
def resume (state : FileCreatedState) (status : Nat) (answer : Bytes) : FileCreatedState :=
  case state as current in FileCreatedState return FileCreatedState with
  | requested args => reporting status answer
  | reporting result body => finished (natAdd result status)
  | finished result => finished result
def requestCode (state : FileCreatedState) : Nat :=
  case state as current in FileCreatedState return Nat with
  | requested args => 36
  | reporting result body => 6
  | finished result => 0
def requestArgs (state : FileCreatedState) : Words :=
  case state as current in FileCreatedState return Words with
  | requested args => args
  | reporting result body => wordsNil
  | finished result => wordsNil
def requestBody (state : FileCreatedState) : Bytes :=
  case state as current in FileCreatedState return Bytes with
  | requested args => bytesCons 0 (bytesCons 255 (bytesCons 65 bytesNil))
  | reporting result body => body
  | finished result => bytesNil
def exitCode (state : FileCreatedState) : Nat :=
  case state as current in FileCreatedState return Nat with
  | requested args => 1
  | reporting result body => result
  | finished result => result

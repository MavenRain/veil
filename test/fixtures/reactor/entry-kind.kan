-- Forward argv to operation 23 and print its answer.
-- The exit status adds the inspection status and the stdout write status.
-- Compile after runtime/reactor.kan.
mu EntryState : Type 0 with
| requested : Words -> EntryState
| reporting : Nat -> Bytes -> EntryState
| finished : Nat -> EntryState

def init (argv : Words) : EntryState := requested argv
def resume (state : EntryState) (status : Nat) (answer : Bytes) : EntryState :=
  case state as current in EntryState return EntryState with
  | requested args => reporting status answer
  | reporting result body => finished (natAdd result status)
  | finished result => finished result
def requestCode (state : EntryState) : Nat :=
  case state as current in EntryState return Nat with
  | requested args => 23
  | reporting result body => 6
  | finished result => 0
def requestArgs (state : EntryState) : Words :=
  case state as current in EntryState return Words with
  | requested args => args
  | reporting result body => wordsNil
  | finished result => wordsNil
def requestBody (state : EntryState) : Bytes :=
  case state as current in EntryState return Bytes with
  | requested args => bytesNil
  | reporting result body => body
  | finished result => bytesNil
def exitCode (state : EntryState) : Nat :=
  case state as current in EntryState return Nat with
  | requested args => 1
  | reporting result body => result
  | finished result => result

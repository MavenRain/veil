-- Update access and modification times, then report the answer and output status.

mu FileTimesState : Type 0 with
| requested : Words -> FileTimesState
| reporting : Nat -> Bytes -> FileTimesState
| finished : Nat -> FileTimesState

def init (argv : Words) : FileTimesState := requested argv
def resume (state : FileTimesState) (status : Nat) (answer : Bytes) : FileTimesState :=
  case state as current in FileTimesState return FileTimesState with
  | requested args => reporting status answer
  | reporting result body => finished (natAdd result status)
  | finished result => finished result
def requestCode (state : FileTimesState) : Nat :=
  case state as current in FileTimesState return Nat with
  | requested args => 44
  | reporting result body => 6
  | finished result => 0
def requestArgs (state : FileTimesState) : Words :=
  case state as current in FileTimesState return Words with
  | requested args => args
  | reporting result body => wordsNil
  | finished result => wordsNil
def requestBody (state : FileTimesState) : Bytes :=
  case state as current in FileTimesState return Bytes with
  | requested args => bytesCons 0 (bytesCons 255 (bytesCons 65 bytesNil))
  | reporting result body => body
  | finished result => bytesNil
def exitCode (state : FileTimesState) : Nat :=
  case state as current in FileTimesState return Nat with
  | requested args => 1
  | reporting result body => result
  | finished result => result

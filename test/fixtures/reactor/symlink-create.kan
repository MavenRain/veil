-- Forward argv as target and destination to operation 25 and print its answer.
-- The exit status adds the creation status and the stdout write status.
-- Compile after runtime/reactor.kan.
mu SymlinkState : Type 0 with
| requested : Words -> SymlinkState
| reporting : Nat -> Bytes -> SymlinkState
| finished : Nat -> SymlinkState

def init (argv : Words) : SymlinkState := requested argv
def resume (state : SymlinkState) (status : Nat) (answer : Bytes) : SymlinkState :=
  case state as current in SymlinkState return SymlinkState with
  | requested args => reporting status answer
  | reporting result body => finished (natAdd result status)
  | finished result => finished result
def requestCode (state : SymlinkState) : Nat :=
  case state as current in SymlinkState return Nat with
  | requested args => 25
  | reporting result body => 6
  | finished result => 0
def requestArgs (state : SymlinkState) : Words :=
  case state as current in SymlinkState return Words with
  | requested args => args
  | reporting result body => wordsNil
  | finished result => wordsNil
def requestBody (state : SymlinkState) : Bytes :=
  case state as current in SymlinkState return Bytes with
  | requested args => bytesNil
  | reporting result body => body
  | finished result => bytesNil
def exitCode (state : SymlinkState) : Nat :=
  case state as current in SymlinkState return Nat with
  | requested args => 1
  | reporting result body => result
  | finished result => result

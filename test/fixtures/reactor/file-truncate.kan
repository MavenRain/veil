-- Resize an existing file, then report the host answer and output status.

mu FileTruncateState : Type 0 with
| requested : Words -> FileTruncateState
| reporting : Nat -> Bytes -> FileTruncateState
| finished : Nat -> FileTruncateState

def init (argv : Words) : FileTruncateState := requested argv
def resume (state : FileTruncateState) (status : Nat) (answer : Bytes) : FileTruncateState :=
  case state as current in FileTruncateState return FileTruncateState with
  | requested args => reporting status answer
  | reporting result body => finished (natAdd result status)
  | finished result => finished result
def requestCode (state : FileTruncateState) : Nat :=
  case state as current in FileTruncateState return Nat with
  | requested args => 30
  | reporting result body => 6
  | finished result => 0
def requestArgs (state : FileTruncateState) : Words :=
  case state as current in FileTruncateState return Words with
  | requested args => args
  | reporting result body => wordsNil
  | finished result => wordsNil
def requestBody (state : FileTruncateState) : Bytes :=
  case state as current in FileTruncateState return Bytes with
  | requested args => bytesCons 0 (bytesCons 255 (bytesCons 65 bytesNil))
  | reporting result body => body
  | finished result => bytesNil
def exitCode (state : FileTruncateState) : Nat :=
  case state as current in FileTruncateState return Nat with
  | requested args => 1
  | reporting result body => result
  | finished result => result

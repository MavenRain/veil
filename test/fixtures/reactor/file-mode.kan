-- Change existing permissions, then report the host answer and output status.

mu FileModeState : Type 0 with
| requested : Words -> FileModeState
| reporting : Nat -> Bytes -> FileModeState
| finished : Nat -> FileModeState

def init (argv : Words) : FileModeState := requested argv
def resume (state : FileModeState) (status : Nat) (answer : Bytes) : FileModeState :=
  case state as current in FileModeState return FileModeState with
  | requested args => reporting status answer
  | reporting result body => finished (natAdd result status)
  | finished result => finished result
def requestCode (state : FileModeState) : Nat :=
  case state as current in FileModeState return Nat with
  | requested args => 31
  | reporting result body => 6
  | finished result => 0
def requestArgs (state : FileModeState) : Words :=
  case state as current in FileModeState return Words with
  | requested args => args
  | reporting result body => wordsNil
  | finished result => wordsNil
def requestBody (state : FileModeState) : Bytes :=
  case state as current in FileModeState return Bytes with
  | requested args => bytesCons 0 (bytesCons 255 (bytesCons 65 bytesNil))
  | reporting result body => body
  | finished result => bytesNil
def exitCode (state : FileModeState) : Nat :=
  case state as current in FileModeState return Nat with
  | requested args => 1
  | reporting result body => result
  | finished result => result

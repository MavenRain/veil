-- Read an access timestamp, then report the host answer and output status.

mu FileAccessedState : Type 0 with
| requested : Words -> FileAccessedState
| reporting : Nat -> Bytes -> FileAccessedState
| finished : Nat -> FileAccessedState

def init (argv : Words) : FileAccessedState := requested argv
def resume (state : FileAccessedState) (status : Nat) (answer : Bytes) : FileAccessedState :=
  case state as current in FileAccessedState return FileAccessedState with
  | requested args => reporting status answer
  | reporting result body => finished (natAdd result status)
  | finished result => finished result
def requestCode (state : FileAccessedState) : Nat :=
  case state as current in FileAccessedState return Nat with
  | requested args => 34
  | reporting result body => 6
  | finished result => 0
def requestArgs (state : FileAccessedState) : Words :=
  case state as current in FileAccessedState return Words with
  | requested args => args
  | reporting result body => wordsNil
  | finished result => wordsNil
def requestBody (state : FileAccessedState) : Bytes :=
  case state as current in FileAccessedState return Bytes with
  | requested args => bytesCons 0 (bytesCons 255 (bytesCons 65 bytesNil))
  | reporting result body => body
  | finished result => bytesNil
def exitCode (state : FileAccessedState) : Nat :=
  case state as current in FileAccessedState return Nat with
  | requested args => 1
  | reporting result body => result
  | finished result => result

-- Update an entry's timestamps without following its final symlink.

mu FileLutimesState : Type 0 with
| requested : Words -> FileLutimesState
| reporting : Nat -> Bytes -> FileLutimesState
| finished : Nat -> FileLutimesState

def init (argv : Words) : FileLutimesState := requested argv
def resume (state : FileLutimesState) (status : Nat) (answer : Bytes) : FileLutimesState :=
  case state as current in FileLutimesState return FileLutimesState with
  | requested args => reporting status answer
  | reporting result body => finished (natAdd result status)
  | finished result => finished result
def requestCode (state : FileLutimesState) : Nat :=
  case state as current in FileLutimesState return Nat with
  | requested args => 47
  | reporting result body => 6
  | finished result => 0
def requestArgs (state : FileLutimesState) : Words :=
  case state as current in FileLutimesState return Words with
  | requested args => args
  | reporting result body => wordsNil
  | finished result => wordsNil
def requestBody (state : FileLutimesState) : Bytes :=
  case state as current in FileLutimesState return Bytes with
  | requested args => bytesCons 0 (bytesCons 255 (bytesCons 65 bytesNil))
  | reporting result body => body
  | finished result => bytesNil
def exitCode (state : FileLutimesState) : Nat :=
  case state as current in FileLutimesState return Nat with
  | requested args => 1
  | reporting result body => result
  | finished result => result

def Bool : Type 0 := sum ((prod () : Type 0), (prod () : Type 0))

def isTrue : (b : Bool) -> Prop :=
  fun (b : Bool) =>
    case b as z return Prop with
    | 0 (x : prod ()) => prod ()
    | 1 (y : prod ()) => sum ()

def Party : Prop := sum (prod (), prod ())
def alice : Party := inj 0 of 2 ()
def bob : Party := inj 1 of 2 ()
def allParties : prod (Nat, Nat) := tuple (1, 1)

def both : (q : prod (Nat, Nat)) -> Prop :=
  fun (q : prod (Nat, Nat)) => isTrue (natEq (natAdd q.0 q.1) 2)

-- The joint function takes one domain for each share.  This one takes
-- three domains and the section holds two shares, so the result after
-- the last share is a function and not the payload type.
def add3 : (x : Nat) -> (y : Nat) -> (z : Nat) -> Nat :=
  fun (x : Nat) (y : Nat) (z : Nat) => natAdd x (natAdd y z)

def bad : (1 a : Nat) -> (1 b : Nat) -> mpc[Party, fun (0 q : prod (Nat, Nat)) => isTrue (natEq (natAdd q.0 q.1) 2)] Nat :=
  fun (1 a : Nat) (1 b : Nat) =>
    mpc allParties (add3 : (x : Nat) -> (y : Nat) -> (z : Nat) -> Nat)
      ((input alice a) : mpc[Party, fun (0 q : prod (Nat, Nat)) => isTrue (natEq (natAdd q.0 q.1) 2)] Nat)
      ((input bob b) : mpc[Party, fun (0 q : prod (Nat, Nat)) => isTrue (natEq (natAdd q.0 q.1) 2)] Nat)
